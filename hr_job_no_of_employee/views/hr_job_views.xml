<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_job_no_of_employee" model="ir.ui.view">
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey" />
        <field name="arch" type="xml">
            <button
                name="%(hr_recruitment.action_hr_job_applications)d"
                position="after"
            >
                <button
                    name="action_open_employees"
                    groups="hr_recruitment.group_hr_recruitment_interviewer"
                    class="oe_stat_button"
                    icon="fa-users"
                    invisible="not employee_count"
                    type="object"
                >
                    <field name="employee_count" widget="statinfo" string="Employees" />
                </button>
            </button>
        </field>
    </record>
</odoo>
