<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.CalendarController" t-inherit-mode="extension">
        <xpath expr="//h5" position="before">
            <t t-if="displayButton">
                <button class="btn btn-primary ms-1" t-on-click="validateWorkentries" title="Validate period work entries" t-att-disabled="!anyDraftWorkentry">Validate period</button>
            </t>
        </xpath>
    </t>
</templates>
