<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="hr_work_entry_employee" model="ir.rule">
        <field name="name">Work entries/Employee : only self</field>
        <field name="model_id" ref="hr_work_entry.model_hr_work_entry" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
        <field name="perm_read" eval="1" />
    </record>

    <record id="hr_work_entry_manager" model="ir.rule">
        <field name="name">Work entries/HR officer : all work entries</field>
        <field name="model_id" ref="hr_work_entry.model_hr_work_entry" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
        <field name="perm_read" eval="1" />
    </record>

    <record id="ir_rule_hr_contract_employee" model="ir.rule">
        <field name="name">HR Contract: Employee</field>
        <field name="model_id" ref="hr_contract.model_hr_contract" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
