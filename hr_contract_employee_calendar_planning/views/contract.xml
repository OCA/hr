<odoo>
    <record id="hr_contract_employee_calendar_planning_form" model="ir.ui.view">
        <field name="name">hr.employee.calendar.planning.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payroll_information']//field[@name='resource_calendar_id']"
                position="replace"
            >
                <field name="resource_calendar_id" invisible="1" />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="hr_contract_employee_calendar_history_form">
        <field name="name">hr.version.employee.calendar.planning.history.form</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_version_list_view" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='resource_calendar_id']" position="replace">
                <field name="resource_calendar_id" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
