<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_users_birthday_mail_inherit" model="ir.ui.view">
        <field name="name">res.users.birthday.mail.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_preferences" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='private_information']//group" position="after">
                <group string="Citizenship">
                    <field name="allow_birthday_wishes" />
                    <field
                        name="notify_others_birthday"
                        invisible="not allow_birthday_wishes"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
