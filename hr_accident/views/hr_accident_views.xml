<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_accident_view_tree" model="ir.ui.view">
        <field name="name">hr.accident.tree - hr_accident</field>
        <field name="model">hr.accident</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="employee_id" />
                <field name="date" />
            </tree>
        </field>
    </record>

    <record id="hr_accident_view_form" model="ir.ui.view">
        <field name="name">hr.accident.form - hr_accident</field>
        <field name="model">hr.accident</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Fall in warehouse" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" />
                        </group>
                        <group>
                            <field name="date" />
                        </group>
                    </group>
                    <separator string="Description" />
                    <field name="description" nolabel="1" />
                    <notebook>
                        <page name="documents" string="Documents">
                            <field name="attachment_ids" widget="many2many_binary" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="hr_accident_action" model="ir.actions.act_window">
        <field name="name">Accidents</field>
        <field name="res_model">hr.accident</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="hr_accident_menu"
        name="Accidents"
        parent="hr.menu_hr_root"
        action="hr_accident_action"
        sequence="90"
    />
</odoo>
