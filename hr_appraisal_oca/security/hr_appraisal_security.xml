<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_hr_appraisal" model="ir.module.category">
        <field name="name">Appraisals</field>
        <field name="description">Helps to evaluate employees...</field>
        <field name="sequence" eval="3" />
    </record>

    <record id="res_groups_privilege_hr_appraisal" model="res.groups.privilege">
        <field name="name">Appraisals</field>
        <field name="category_id" ref="module_category_hr_appraisal" />
    </record>

    <record id="group_appraisal_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_appraisal" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_appraisal_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_appraisal" />
        <field
            name="implied_ids"
            eval="[(4, ref('hr_appraisal_oca.group_appraisal_user'))]"
        />
    </record>

    <!-- Preserve access for internal users outside the appraisal groups.
         Appraisal users receive their domain-limited permission below. -->
    <record id="access_hr_appraisal_all" model="ir.access">
        <field name="name">hr.appraisal all</field>
        <field name="model_id" ref="model_hr_appraisal" />
        <field name="group_id" ref="base.group_user" />
        <field name="operation">crud</field>
        <field name="domain">
            [(0, '=', 1)] if user.has_group('hr_appraisal_oca.group_appraisal_user') else []
        </field>
    </record>

    <!-- Global multi-company restriction, including HR officers. -->
    <record id="hr_appraisal_comp_rule" model="ir.access">
        <field name="name">Appraisal multi-company</field>
        <field name="model_id" ref="hr_appraisal_oca.model_hr_appraisal" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="hr_appraisal_access_rule" model="ir.access">
        <field name="name">Appraisals - User Access</field>
        <field name="model_id" ref="hr_appraisal_oca.model_hr_appraisal" />
        <field name="operation">crud</field>
        <field name="domain">
            ['&amp;',
                '|','|',
                    ('employee_id.user_id','=',user.id),
                    ('employee_id.allowed_user_ids','in',[user.id]),
                    ('manager_ids.user_id','in',[user.id]),
                '|',
                    ('visibility', '=', 'all'),
                    '&amp;',
                        ('visibility', '=', 'manager'),
                        ('manager_ids.user_id', 'in', [user.id])
            ]
        </field>
        <field name="group_id" ref="group_appraisal_user" />
    </record>

    <record id="hr_appraisal_hr_officer_rule" model="ir.access">
        <field name="name">Appraisals - HR Officer Full Access</field>
        <field name="model_id" ref="hr_appraisal_oca.model_hr_appraisal" />
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
        <!-- no restrictions -->
        <field name="group_id" ref="group_appraisal_hr_officer" />
    </record>
</odoo>
