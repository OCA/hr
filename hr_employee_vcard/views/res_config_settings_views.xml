<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="hr" position="inside">
                <block title="Employee vCard" name="employee_vcard_settings">
                    <setting
                        id="vcard_layout_settings"
                        string="vCard Layout"
                        help="Choose the layout used for vCard reports."
                    >
                        <div class="content-group">
                            <div class="mt16" invisible="not vcard_layout_id">
                                <label
                                    for="vcard_layout_view_id"
                                    string="Layout"
                                    class="col-3 col-lg-3 o_light_label"
                                />
                                <field
                                    name="vcard_layout_view_id"
                                    class="oe_inline"
                                    readonly="1"
                                />
                            </div>
                            <div class="mt8">
                                <button
                                    string="Configure vCard Layout"
                                    name="%(hr_employee_vcard.action_hr_employee_vcard_wizard)d"
                                    icon="oi-arrow-right"
                                    type="action"
                                    class="btn-link"
                                />
                            </div>
                            <div class="mt8">
                                <button
                                    string="Preview vCard"
                                    name="action_preview_vcard"
                                    icon="oi-arrow-right"
                                    type="object"
                                    class="btn-link"
                                    invisible="not vcard_layout_id"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
