<odoo>
    <record model="ir.ui.view" id="stock_reference_form_view">
        <field name="name">stock.reference.form (in hr_personal_equipment_stock)</field>
        <field name="model">stock.reference</field>
        <field name="inherit_id" ref="stock.stock_reference_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_ids']" position="after">
                <field name="equipment_request_id" groups="stock.group_stock_user" />
            </xpath>
        </field>
    </record>
</odoo>
