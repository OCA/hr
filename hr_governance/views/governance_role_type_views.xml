<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--governance.role.type-->
    <record id="governance_role_type_view_tree" model="ir.ui.view">
        <field name="model">governance.role.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="governance_role_type_view_form" model="ir.ui.view">
        <field name="model">governance.role.type</field>
        <field name="arch" type="xml">
            <form string="Circle Type">
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="type" />
                            <field name="source_circle_id" />
                            <field name="enable_edit_circle" />
                        </group>
                        <group>
                            <field name="color" widget="circlepack_color_picker" />
                        </group>
                        <div colspan="2">
                            <label for="purpose" />
                            <field name="purpose" />
                        </div>
                        <div colspan="2">
                            <label for="expectation" />
                            <field name="expectation" />
                        </div>
                        <div colspan="2">
                            <label for="authority" />
                            <field name="authority" />
                        </div>
                        <group />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="governance_role_type_action" model="ir.actions.act_window">
        <field name="name">Governance Role Type</field>
        <field name="res_model">governance.role.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
