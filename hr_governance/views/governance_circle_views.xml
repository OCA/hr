<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="governance_circle_view_search" model="ir.ui.view">
        <field name="model">governance.circle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field
                    filter_domain="[                         '|',                         ('role_assignment_ids.member_id', 'ilike', self),                         ('circle_member_ids', 'ilike', self)                     ]"
                    name="circle_member_ids"
                    string="Employee"
                />
                <field name="purpose" string="Raison d'être" />
                <field name="authority" string="Domain of authority" />
                <field name="expectation" string="Expectations" />
            </search>
        </field>
    </record>
    <record id="governance_circle_view_search_normal" model="ir.ui.view">
        <field name="model">governance.circle</field>
        <field name="inherit_id" ref="hr_governance.governance_circle_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field
                        enable_counters="1"
                        icon="fa-building"
                        name="parent_id"
                        string="Hierarchy"
                    />
                </searchpanel>
            </xpath>
        </field>
    </record>
    <record id="governance_circle_view_tree" model="ir.ui.view">
        <field name="model">governance.circle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="governance_circle_view_form" model="ir.ui.view">
        <field name="model">governance.circle</field>
        <field name="arch" type="xml">
            <form js_class="governance_form_view">
                <sheet>
                    <span invisible="not is_circle">Circle</span>
                    <span invisible="is_circle">Role</span>
                    <h1>
                        <field name="name" />
                        <field invisible="1" name="is_addable" />
                        <field invisible="1" name="is_circle" />
                    </h1>
                    <group>
                        <div colspan="2" invisible="not is_circle">
                            <label for="circle_member_ids" />
                            <field
                                name="circle_member_ids"
                                readonly="1"
                                widget="clickable_many2many_avatar_user"
                            />
                        </div>
                    </group>
                    <br />
                    <group invisible="is_circle">
                        <div colspan="2">
                            <field
                                name="role_assignment_ids"
                                nolabel="1"
                                options="{'create': [('is_addable','=',True)]}"
                            >
                                <list editable="bottom">
                                    <field name="member_id" />
                                    <field name="percentage" widget="percentage" />
                                    <field name="focus" />
                                </list>
                            </field>
                        </div>
                    </group>
                    <group>
                        <field invisible="1" name="is_editable" />
                        <div colspan="2">
                            <label for="purpose" string="raison d'être" />
                            <field name="purpose" readonly="not is_editable" />
                        </div>
                        <div colspan="2">
                            <label for="expectation" string="Expectations" />
                            <field name="expectation" readonly="not is_editable" />
                        </div>
                        <div colspan="2">
                            <label for="authority" string="Domain of authority" />
                            <field name="authority" readonly="not is_editable" />
                        </div>
                    </group>
                    <group>
                        <group>
                            <field invisible="1" name="is_color_field_invisible" />
                            <field
                                invisible="is_color_field_invisible"
                                name="color"
                                readonly="not is_editable"
                                widget="circlepack_color_picker"
                            />
                            <field invisible="1" name="child_ids" />
                        </group>
                        <group groups="hr_governance.governance_group_manager">
                            <field invisible="1" name="suitable_type_ids" />
                            <field invisible="is_circle" name="type_id" />
                        </group>
                        <group groups="hr_governance.governance_group_manager">
                            <field
                                name="parent_id"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field invisible="is_circle" name="shape_type" />
                        </group>
                    </group>
                    <br />
                    <chatter />
                </sheet>
            </form>
        </field>
    </record>
    <record id="governance_circle_action" model="ir.actions.act_window">
        <field name="name">Governance</field>
        <field name="res_model">governance.circle</field>
        <field name="view_mode">form</field>
    </record>
    <record id="governance_chart_client_action" model="ir.actions.client">
        <field name="name">Governance Chart</field>
        <field name="tag">governance_chart_action</field>
    </record>
    <record id="governance_circle_normal_view_action" model="ir.actions.act_window">
        <field name="name">Governance</field>
        <field name="res_model">governance.circle</field>
        <field
            name="search_view_id"
            ref="hr_governance.governance_circle_view_search_normal"
        />
        <field name="view_mode">list,form</field>
    </record>
</odoo>
