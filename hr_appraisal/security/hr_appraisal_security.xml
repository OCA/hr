<?xml version="1.0" ?>
<odoo>
    <record id="module_category_hr_appraisal" model="ir.module.category">
        <field name="name">Appraisal</field>
        <field name="description">Helps to evaluate employees...</field>
        <field name="sequence">3</field>
    </record>

    <record id="group_appraisal_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="hr_appraisal.module_category_hr_appraisal"/>
    </record>

    <record id="group_appraisal_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="hr_appraisal.module_category_hr_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_employee'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <record id="group_appraisal_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="category_id" ref="hr_appraisal.module_category_hr_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('group_appraisal_manager'))]"/>
    </record>

    <record id="property_rule_hr_appraisal" model="ir.rule">
        <field name="name">Hr Appraisal Multi Company</field>
        <field name="model_id" ref="hr_appraisal.model_hr_appraisal_employee"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            ['&amp;',
                '|',
                    ('employee_id.allowed_user_ids', 'in', [user.id]),
                    ('manager_ids.user_id', 'in', [user.id]),
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'child_of', [user.company_id.id])
            ]
        </field>
        <field name="groups" eval="[
            (4, ref('hr_appraisal.group_appraisal_manager')),
            (4, ref('hr_appraisal.group_appraisal_hr_officer'))
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_appraisal_rule" model="ir.rule">
        <field name="name">Appraisal Forms</field>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="global" eval="False"/>
        <field name="model_id" ref="hr_appraisal.model_hr_appraisal_employee"/>
        <field name="groups" eval="[(4,ref('hr_appraisal.group_appraisal_employee'))]"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_appraisal_hr_officer_rule" model="ir.rule">
        <field name="name">Appraisals - HR Officer Full Access</field>
        <field name="model_id" ref="hr_appraisal.model_hr_appraisal_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field> <!-- sin restricciones -->
        <field name="global" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_appraisal_hr_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Añadir reglas de acceso para hr.appraisal.wizard -->
    <record id="access_hr_appraisal_wizard_user" model="ir.model.access">
        <field name="name">hr.appraisal.wizard user</field>
        <field name="model_id" ref="model_hr_appraisal_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_employee"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_hr_appraisal_wizard_manager" model="ir.model.access">
        <field name="name">hr.appraisal.wizard manager</field>
        <field name="model_id" ref="model_hr_appraisal_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_hr_appraisal_wizard_hr_officer" model="ir.model.access">
        <field name="name">hr.appraisal.wizard hr officer</field>
        <field name="model_id" ref="model_hr_appraisal_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_hr_officer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Añadir reglas de acceso para hr.appraisal.request.wizard -->
    <record id="access_hr_appraisal_request_wizard_user" model="ir.model.access">
        <field name="name">hr.appraisal.request.wizard user</field>
        <field name="model_id" ref="model_hr_appraisal_request_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_employee"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_hr_appraisal_request_wizard_manager" model="ir.model.access">
        <field name="name">hr.appraisal.request.wizard manager</field>
        <field name="model_id" ref="model_hr_appraisal_request_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_hr_appraisal_request_wizard_hr_officer" model="ir.model.access">
        <field name="name">hr.appraisal.request.wizard hr officer</field>
        <field name="model_id" ref="model_hr_appraisal_request_wizard"/>
        <field name="group_id" ref="hr_appraisal.group_appraisal_hr_officer"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>