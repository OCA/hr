#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    An appraisal of <t t-out=\"object.employee_id.name or "
"'employee'\"></t> has been confirmed.<br>\n"
"                    <br><br>\n"
"                    Please schedule an appraisal date together.\n"
"                    <br><br>\n"
"                    <t t-if=\"ctx.get('recipient_users')\">\n"
"                        <p style=\"margin: 16px 0px 16px 0px; text-align: "
"center;\">\n"
"                            <t t-set=\"link\" t-value=\"'/mail/view?model=hr."
"appraisal.employee&amp;res_id=%s' % object.id\"></t>\n"
"                            <a style=\"background-color:#875A7B; padding: "
"8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;\" "
"t-att-href=\"link\">View Appraisal</a>\n"
"                        </p>\n"
"                    </t>\n"
"                </p>\n"
"            </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"          <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                Una valoración de <t t-out=\"object.employee_id.name or "
"'employee'\"></t> se ha confirmado.\n"
"                <br><br>\n"
"                Por favor, programe una fecha de evaluación juntos.\n"
"                <br><br>\n"
"                <t t-if=\"ctx.get('recipient_users')\">\n"
"                  <p style=\"margin: 16px 0px 16px 0px; text-align: center;"
"\">\n"
"\t\t\t<t t-set=\"link\" t-value=\"'/mail/view?model=hr.appraisal."
"employee&amp;res_id=%s' % object.id\"></t>\n"
"\t\t\t<a style=\"background-color:#875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px;\" t-att-href=\"link\">Ver "
"valoración</a>\n"
"\t\t</p>\n"
"               </t>\n"
"              </p>\n"
"            </div>"

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_request_from_employee
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear\n"
"                        <t t-foreach=\"object.manager_ids\" t-"
"as=\"manager\">\n"
"                            <t t-if=\"manager.work_email\">\n"
"                                <t t-out=\"manager.name or ''\"></t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <br>\n"
"                        <t t-out=\"user.name or ''\"></t> wishes an "
"appraisal.<br>\n"
"                        <br>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\"> </t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; text-align: center;\">\n"
"                                <t t-set=\"link\" t-value=\"'/mail/view?"
"model=hr.appraisal.employee&amp;res_id=%s' % object.id\"></t>\n"
"                                <a style=\"margin: auto; background-color:"
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px;\" t-att-href=\"link\">View Appraisal</a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                   <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                    Estimado/a\n"
"                    <t t-foreach=\"object.manager_ids\" t-as=\"manager\">\n"
"                        <t t-if=\"manager.work_email\">\n"
"                            <t t-out=\"manager.name or ''\"></t>,\n"
"                     </t>\n"
"                    </t>\n"
"                    <br>\n"
"                    <t t-out=\"user.name or ''\"></t> desea una valoración."
"<br>\n"
"                    <br>\n"
"<t t-if=\"ctx.get('user_body')\">\n"
"                            </t></p><div style=\"margin: 16px 0px 16px 0px; "
"padding: 8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\"> </t>\n"
"                            </div>\n"
"<t t-if=\"ctx.get('recipient_users')\">\n"
"                        <p style=\"margin: 16px 0px 16px 0px; padding: 8px "
"16px 8px 16px; text-align: center;\">\n"
"                            <t t-set=\"link\" t-value=\"'/mail/view?model=hr."
"appraisal.employee&amp;res_id=%s' % object.id\"></t>\n"
"                            <a style=\"margin: auto; background-color:"
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px;\" t-att-href=\"link\">Ver valoración</a>\n"
"                        </p>\n"
"                    </t>\n"
"                </div>"

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_completed
msgid ""
"<div>\n"
"                The appraisal's status has been set to <strong style=\"box-"
"sizing:border-box;font-weight:bold;\">Done</strong> by <t t-out=\"user.name "
"or ''\"></t>.<br>\n"
"                <br>\n"
"                <t t-if=\"ctx.get('recipient_users')\">\n"
"                    <p style=\"box-sizing:border-box;margin-top:24px;margin-"
"bottom:16px\">\n"
"\t\t\t\t\t\t<t t-set=\"link\" t-value=\"'/mail/view?model=hr.appraisal."
"employee&amp;res_id=%s' % object.id\"></t>\n"
"\t\t\t\t\t\t<a style=\"box-sizing:border-box;text-decoration:none;color:"
"#7c7bad;background-color:#875A7B;padding:10px; color:#fff; border-radius:5px;"
"\" t-att-href=\"link\">View Employee Appraisal</a>\n"
"\t\t\t\t\t</p>\n"
"                </t>\n"
"            </div>\n"
"            "
msgstr ""
"<div>\n"
"               El estado de la evaluación se ha establecido en <strong "
"style=\"box-sizing:border-box;font-weight:bold;\">Hecho</strong> por <t t-"
"out=\"user.name or ''\"></t>.<br>\n"
"                <br>\n"
"<t t-if=\"ctx.get('recipient_users')\">\n"
"                    <p style=\"box-sizing:border-box;margin-top:24px;margin-"
"bottom:16px\">\n"
"\t\t\t\t\t\t<t t-set=\"link\" t-value=\"'/mail/view?model=hr.appraisal."
"employee&amp;res_id=%s' % object.id\"></t>\n"
"\t\t\t\t\t\t<a style=\"box-sizing:border-box;text-decoration:none;color:"
"#7c7bad;background-color:#875A7B;padding:10px; color:#fff; border-"
"radius:5px\" t-att-href=\"link\">Ver la evaluación del empleado</a>\n"
"\t\t\t\t\t</p>\n"
"                </t>\n"
"            </div>\n"
"            "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear\n"
"                        <t t-if=\"object.employee_id.work_email\">\n"
"                            <t t-out=\"object.employee_id.name or ''\"></"
"t>,\n"
"                        </t>\n"
"                        <t t-foreach=\"object.manager_ids\" t-"
"as=\"manager\">\n"
"                            <t t-if=\"user.id not in object.manager_user_ids."
"ids\">\n"
"                                <t t-out=\"manager.name or ''\"></t>,\n"
"                            </t>\n"
"                        </t>\n"
"                        <br>\n"
"                            An appraisal has been requested by <t t-"
"out=\"user.name or ''\"></t>.<br>\n"
"                        <br>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\"> </t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; text-align: center;\">\n"
"                                <t t-set=\"link\" t-value=\"'/mail/view?"
"model=hr.appraisal.employee&amp;res_id=%s' % object.id\"></t>\n"
"                                <a style=\"margin: auto; background-color:"
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px;\" t-att-href=\"link\">View Appraisal</a>\n"
"                            </p>\n"
"                        </t>\n"
"                        <br>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                   Estimado/a\n"
"    <t t-if=\"object.employee_id.work_email\">\n"
"        <t t-out=\"object.employee_id.name or ''\"></t>,\n"
"    </t>\n"
"    <t t-foreach=\"object.manager_ids\" t-as=\"manager\">\n"
"        <t t-if=\"user.id not in object.manager_user_ids.ids\">\n"
"            <t t-out=\"manager.name or ''\"></t>,\n"
"        </t>\n"
"    </t>\n"
"    <br>\n"
"    Se ha solicitado una valoración de parte de <t t-out=\"user.name or "
"''\"></t>.<br>\n"
"    <br>\n"
"<t t-if=\"ctx.get('user_body')\">\n"
"                            </t></p><div style=\"margin: 16px 0px 16px 0px; "
"padding: 8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\"> </t>\n"
"                            </div>\n"
"<t t-if=\"ctx.get('recipient_users')\">\n"
"                         <p style=\"margin: 16px 0px 16px 0px; padding: 8px "
"16px 8px 16px; text-align: center;\">\n"
"                            <t t-set=\"link\" t-value=\"'/mail/view?model=hr."
"appraisal.employee&amp;res_id=%s' % object.id\"></t>\n"
"                            <a style=\" margin: auto; background-color:"
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px;\" t-att-href=\"link\">Ver valoración</a>\n"
"                        </p>\n"
"                    </t>\n"
"</div>"

