<odoo>
    <record id="res_users_view_form_preferences_astral" model="ir.ui.view">
        <field name="name">res.users.preferences.form.astral</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="astral_daily_horoscope" readonly="0" />
            </xpath>
        </field>
    </record>
</odoo>
