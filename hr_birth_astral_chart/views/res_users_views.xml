<odoo>
    <record id="res_users_view_form_preferences_astral" model="ir.ui.view">
        <field name="name">res.users.preferences.form.astral</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="astral_daily_horoscope" readonly="0" />
            </xpath>
        </field>
    </record>

    <!-- The employee's own chart: hr.employee is out of reach for them -->
    <record id="res_users_view_form_astral_chart" model="ir.ui.view">
        <field name="name">res.users.astral.chart.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="My Astral Chart" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="birth_chart_available"
                    >
                        <i class="fa fa-warning me-1" />
                        Your <strong>date of birth</strong> is not on your employee
                        profile yet, so there is no chart to show. Your HR contact
                        can add it.
                    </div>

                    <div invisible="not birth_chart_available">
                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <div
                                class="card text-center px-3 py-2"
                                style="min-width:160px"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size:11px;letter-spacing:1px"
                                >Sun Sign</div>
                                <div class="fs-5 fw-bold">
                                    <field name="birth_chart_sun_sign" readonly="1" />
                                </div>
                            </div>
                            <div
                                class="card text-center px-3 py-2"
                                style="min-width:160px"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size:11px;letter-spacing:1px"
                                >Moon Sign</div>
                                <div class="fs-5 fw-bold">
                                    <field name="birth_chart_moon_sign" readonly="1" />
                                </div>
                            </div>
                            <div
                                class="card text-center px-3 py-2"
                                style="min-width:160px"
                            >
                                <div
                                    class="text-uppercase text-muted fw-semibold"
                                    style="font-size:11px;letter-spacing:1px"
                                >Ascendant</div>
                                <div class="fs-5 fw-bold">
                                    <field
                                        name="birth_chart_rising_sign"
                                        readonly="1"
                                    />
                                </div>
                            </div>
                            <div
                                class="card px-3 py-2 d-flex align-items-center justify-content-center text-warning-emphasis bg-warning-subtle border-warning-subtle"
                                style="min-width:220px;font-size:12px"
                                invisible="birth_chart_exact"
                            >
                                <i class="fa fa-info-circle me-1" />
                                Your birth time and coordinates are not both on
                                file, so the Ascendant and Houses cannot be
                                computed. Your HR contact can add them.
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-4 align-items-start">
                            <div style="flex:0 0 auto">
                                <field
                                    name="birth_chart_svg"
                                    widget="html"
                                    readonly="1"
                                    style="display:block;width:520px;height:520px"
                                />
                            </div>
                            <div style="flex:1 1 300px">
                                <h5 class="text-warning mb-2">Planetary Positions</h5>
                                <field
                                    name="birth_chart_planets_json"
                                    widget="birth_chart_table"
                                    readonly="1"
                                />
                                <div class="mt-3" invisible="not birth_chart_exact">
                                    <h5 class="text-warning mb-2">Houses</h5>
                                    <field
                                        name="birth_chart_houses_html"
                                        widget="html"
                                        readonly="1"
                                    />
                                </div>
                            </div>
                        </div>

                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title text-warning">
                                    Chart Interpretation
                                </h5>
                                <field
                                    name="birth_chart_interpretation"
                                    widget="html"
                                    readonly="1"
                                />
                            </div>
                        </div>

                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title text-info">
                                    Current Transits:
                                    <span
                                    class="text-muted fw-normal"
                                    style="font-size:13px"
                                >how today's sky influences your natal chart</span>
                                </h5>
                                <div class="d-flex flex-wrap gap-4 align-items-start">
                                    <div style="flex:0 0 auto">
                                        <field
                                            name="birth_chart_transit_svg"
                                            widget="html"
                                            readonly="1"
                                            style="display:block;width:560px;height:560px"
                                        />
                                    </div>
                                    <div style="flex:1 1 300px">
                                        <h5 class="text-info mb-2">
                                            Transit Positions
                                        </h5>
                                        <field
                                            name="birth_chart_transit_json"
                                            widget="birth_chart_table"
                                            readonly="1"
                                        />
                                        <field
                                            name="birth_chart_transit_aspects"
                                            widget="html"
                                            readonly="1"
                                        />
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <field
                                        name="birth_chart_transit_interpretation"
                                        widget="html"
                                        readonly="1"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_astral_chart" model="ir.actions.server">
        <field name="name">My Astral Chart</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="state">code</field>
        <field name="code">action = env.user._action_my_astral_chart()</field>
        <!-- Without this, running the action would demand write access on
             res.users, which an employee does not have -->
        <field name="group_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <menuitem
        id="menu_my_astral_chart"
        name="My Astral Chart"
        parent="hr.menu_hr_root"
        action="action_my_astral_chart"
        groups="base.group_user"
        sequence="90"
    />
</odoo>
