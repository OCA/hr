<odoo>
    <record id="group_hr_shift_user" model="res.groups">
        <field name="name">User</field>
        <field
            name="category_id"
            ref="base.module_category_human_resources_employees"
        />
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>
    <record id="group_hr_shift_manager" model="res.groups">
        <field name="name">Manager</field>
        <field
            name="category_id"
            ref="base.module_category_human_resources_employees"
        />
        <field
            name="implied_ids"
            eval="[(6, 0, [ref('hr_shift_planning.group_hr_shift_user')])]"
        />
        <field
            name="comment"
        >The user will be able to approve document created by employees.</field>
    </record>
    <record id="group_hr_shift_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field
            name="category_id"
            ref="base.module_category_human_resources_employees"
        />
        <field
            name="implied_ids"
            eval="[(6, 0, [ref('hr_shift_planning.group_hr_shift_manager')])]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
